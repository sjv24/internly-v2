{
  "name": "internly",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db": "node scripts/db.mjs",
    "dev": "concurrently -k -n db,api,web -c gray,blue,green \"npm run db\" \"npm run dev -w @internly/api\" \"npm run dev -w @internly/web\"",
    "dev:api": "npm run dev -w @internly/api",
    "dev:web": "npm run dev -w @internly/web",
    "build": "npm run build -w @internly/web",
    "start": "npm run start -w @internly/api",
    "db:seed": "npm run db:seed -w @internly/api",
    "db:reset": "node scripts/db-reset.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.0"
  },
  "type": "module"
}
