{
  "name": "internly-vanilla",
  "version": "1.0.0",
  "private": true,
  "description": "Internly: internship portal built with Node.js, Express, PostgreSQL and plain HTML/CSS/JavaScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db": "node scripts/db.mjs",
    "dev": "concurrently -k -n db,app -c gray,blue \"npm run db\" \"node --watch server/index.js\"",
    "start": "node server/index.js",
    "test": "vitest run",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node server/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
