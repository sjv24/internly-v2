# Copy to .env (`npm run setup` does this for you). Never commit the real .env.
NODE_ENV=development
PORT=8080

# Local dev database started by `npm run db` (embedded PostgreSQL, no Docker needed)
DATABASE_URL=postgres://postgres:postgres@localhost:54329/internly

# Browser origin(s) allowed to call the API with cookies (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Insert demo companies, listings and accounts when the database is empty
SEED_ON_EMPTY=true

# --- AI CV matcher ---
# Leave AI_API_KEY empty to use the built-in offline provider (works with no key).
# Set it to an Anthropic API key to get model-written explanations instead.
AI_API_KEY=
AI_MODEL=claude-opus-5-5
