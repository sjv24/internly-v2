# Copy to .env (`npm run setup` does this for you). Never commit the real .env.
NODE_ENV=development
PORT=3000

# Local database started by `npm run db` (embedded PostgreSQL, no Docker needed)
DATABASE_URL=postgres://postgres:postgres@localhost:54330/internly_vanilla

# Origin(s) the browser app is served from (used by the CSRF check)
APP_ORIGIN=http://localhost:3000

# Insert demo companies, listings and accounts when the database is empty
SEED_ON_EMPTY=true

# --- AI CV matcher ---
# Leave AI_API_KEY empty to use the built-in offline explanation writer (works with no key).
# Set it to an Anthropic API key to get model-written explanations instead.
AI_API_KEY=
AI_MODEL=claude-opus-5-5
